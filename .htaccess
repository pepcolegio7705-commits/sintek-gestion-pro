# 2. ENDPOINTS AJAX (Motores de Datos)
# ---------------------------------------------------------
# Trae los agentes pendientes de cobro para la tabla principal
RewriteRule ^tesoreria/obtener-pendientes$ ajax/tesoreria/obtener_pendientes_liquidacion.php [L,QSA]

# Procesa la inserción masiva en la base de datos (crea el lote)
RewriteRule ^tesoreria/procesar-liquidacion-masiva$ ajax/tesoreria/procesar_liquidacion_masiva.php [L,QSA]

# Trae los lotes para el listado de gestión
RewriteRule ^tesoreria/obtener-lotes$ ajax/tesoreria/obtener_lotes_liquidaciones.php [L,QSA]

# Autoriza (Cierra) o Anula un lote con contraseña de Admin
RewriteRule ^tesoreria/ejecutar-accion-lote$ ajax/tesoreria/ejecutar_accion_lote.php [L,QSA]

# Verifica permiso especial de tesorería (cambio de fechas/periodos)
RewriteRule ^tesoreria/autorizar-periodo$ ajax/tesoreria/verificar_permiso_tesoreria.php [L,QSA]
# Descarga de archivo bancario (Ej: tesoreria/descargar-txt/45)
RewriteRule ^tesoreria/descargar-txt/([0-9]+)$ ajax/tesoreria/descargar_archivo_banco.php?id_lote=$1 [L,QSA]

RewriteRule ^tesoreria/configurar-layouts$ modules/tesoreria/configurar_layouts.php [L]
# Ruta para guardar la configuración del banco
RewriteRule ^tesoreria/guardar-layout-banco$ modules/tesoreria/guardar_layout_banco.php [L]

RewriteRule ^tesoreria/obtener-detalle-layout$ ajax/tesoreria/obtener_detalle_layout.php [L]

RewriteRule ^tesoreria/eliminar-banco$ ajax/tesoreria/eliminar_banco.php [L]
# Regla para descarga amigable de TXT de lotes
RewriteRule ^tesoreria/descargar-txt/([0-9]+)$ ajax/tesoreria/descarga_directa_txt.php?id=$1 [L,QSA]

# Regla para informar rechazo bancario
RewriteRule ^tesoreria/rechazar-lote-banco$ ajax/tesoreria/rechazar_lote_banco.php [L]

# Liquidación Individual con Token
RewriteRule ^tesoreria/liquidar/([^/]+)$ modules/tesoreria/liquidar_haberes.php?token=$1 [L,QSA]
# Regla para imprimir recibo encriptado
# Ejemplo: tesoreria/imprimir-recibo/TOKEN_GIGANTE/A4
RewriteRule ^tesoreria/imprimir-recibo/([^/]+)/([^/]+)$ modules/tesoreria/imprimir_recibo_haber.php?id=$1&f=$2 [L,QSA]

# ----------------------------------------------------------------      
# MÓDULO DE GESTIÓN DE GASTOS Y EGRESOS
# ----------------------------------------------------------------

# Interfaz Principal de Gastos
RewriteRule ^tesoreria/gastos$ modules/tesoreria/gestion_gastos.php [L,QSA]

# Obtener categorías para los selectores (AJAX)
RewriteRule ^tesoreria/obtener-categorias-gastos$ ajax/tesoreria/obtener_categorias_gastos.php [L,QSA]

# Guardar nueva categoría de gasto (AJAX)
RewriteRule ^tesoreria/guardar-categoria-gasto$ ajax/tesoreria/guardar_categoria_gasto.php [L,QSA]

# Servidor de Tabla de Gastos (Server-side DataTables)
RewriteRule ^tesoreria/ajax-server-gastos$ ajax/tesoreria/ajax_server_gastos.php [L,QSA]

# Procesar nuevo gasto manual (POST)
RewriteRule ^tesoreria/procesar-gasto$ ajax/tesoreria/procesar_gasto.php [L,QSA]

# Anular un gasto registrado (AJAX)
RewriteRule ^tesoreria/anular-gasto$ ajax/tesoreria/anular_gasto.php [L,QSA]



# --- REGLA GENERAL PARA PHP (la que ya tenías) ---
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [NC,L]

# 7. Evitar el acceso al propio .htaccess
<Files .htaccess>
    Require all denied
</Files>