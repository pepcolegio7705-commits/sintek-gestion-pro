# 1. Seguridad Básica: Desactivar listado de directorios
Options -Indexes

# 2. Activar motor de reescritura
RewriteEngine On

# 3. Ocultar la extensión .php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [NC,L]

# ESTO ES LO MÁS IMPORTANTE PARA LOCALHOST
RewriteBase /sintek-gestion-pro/

# 4. Protección de carpetas críticas (Sintaxis compatible con .htaccess)
# En lugar de <Directory>, usamos RewriteRules para denegar el acceso
# RewriteRule ^(core|vistas|ajax|sql)/ - [F,L]

# 5. Proteger archivos específicos por extensión
<FilesMatch "\.(env|log|ini|json|sql)$">
    Require all denied
</FilesMatch>

# 6. Proteger archivos específicos del núcleo
<FilesMatch "^(conexion|config|funciones|seguridad)\.php$">
    Require all denied
</FilesMatch>
# Rutas amigables para Alumnos
RewriteRule ^alumnos/gestion$ modules/alumnos/alumnos_abm.php [L,QSA]
RewriteRule ^alumnos/editar/([a-z0-9-]+)$ modules/alumnos/alumnos_abm.php?uuid=$1 [L,QSA]
RewriteRule ^alumnos/eliminar/([a-z0-9-]+)$ modules/alumnos/alumnos_abm.php?action=delete&uuid=$1 [L,QSA]
RewriteRule ^alumnos/historico$ modules/alumnos/alumnos_historico.php [L,QSA]

# 2. Expediente PDF: alumnos/expediente/ID -> ajax/alumnos/imprimir_ficha.php?id=ID
RewriteRule ^alumnos/expediente/([a-z0-9-]+)$ ajax/alumnos/alumno_expediente.php?uuid=$1 [L,QSA]

# 3. Acción Toggle Estado: alumnos/toggle_estado -> ajax/alumnos/alumnos_actions_handler.php
RewriteRule ^alumnos/toggle_estado$ ajax/alumnos/alumnos_actions_handler.php [L,QSA]
# Cambiamos la regla para que sea coherente con el nombre del archivo
RewriteRule ^alumnos/ficha/([a-z0-9-]+)$ ajax/alumnos/imprimir_ficha.php?uuid=$1 [L,QSA]
RewriteRule ^alumnos/reporte/activos$ ajax/alumnos/reporte_activos_pdf.php [L,QSA]

# Rutas para Documentación de Alumnos
RewriteRule ^alumnos/analitico/([a-z0-9-]+)$ ajax/alumnos/generar_analitico.php?uuid=$1 [L,QSA]
# Regla para Certificado de Materias Aprobadas
RewriteRule ^alumnos/analitico-aprobado/([a-z0-9-]+)$ ajax/alumnos/generar_analitico_aprobado.php?uuid=$1 [L,QSA]
# Regla para Acta de Egreso / Certificado de Título
RewriteRule ^alumnos/acta-egreso/([a-z0-9-]+)$ ajax/alumnos/generar_acta_egreso.php?uuid=$1 [L,QSA]


# Regla para el Analítico Histórico Provisorio
RewriteRule ^alumnos/analitico/([a-z0-9-]+)$ ajax/alumnos/generar_analitico.php?uuid=$1 [L,QSA]

# Gestión de Usuarios: usuarios/gestion -> modules/usuarios/usuarios_abm.php
RewriteRule ^usuarios/gestion$ modules/usuarios/usuarios_abm.php [L,QSA]

# --- MÓDULO MATERIAS (ESPACIOS) ---
RewriteRule ^materias/gestion$ modules/espacios/espacios_abm.php [L,QSA]

# Cambio de ID numérico a UUID (Acepta caracteres alfanuméricos y guiones)
RewriteRule ^materias/editar/([a-z0-9-]+)$ modules/espacios/espacios_abm.php?action=edit&uuid=$1 [L,QSA]

# Ruta amigable para el motor de la tabla
RewriteRule ^materias/data_server$ ajax/espacios/server_processing_espacios.php [L,QSA]

# Reportes con UUID
RewriteRule ^materias/lista/([a-z0-9-]+)$ ajax/espacios/imprimir_lista_espacio.php?uuid=$1 [L,QSA]

# --- MÓDULO CARRERAS ---
RewriteRule ^carreras/gestion$ modules/carreras/carreras_abm.php [L,QSA]
RewriteRule ^carreras/editar/([0-9]+)$ modules/carreras/carreras_abm.php?action=edit&id=$1 [L,QSA]
RewriteRule ^carreras/data_server$ ajax/carreras/server_processing_carreras.php [L,QSA]
RewriteRule ^carreras/get_alumnos$ ajax/carreras/get_alumnos_por_carrera.php [L,QSA]
# Reporte Institucional: Listado de Alumnos por Carrera
RewriteRule ^carreras/imprimir/([0-9]+)$ ajax/carreras/imprimir_lista_carrera.php?id_carrera=$1 [L,QSA]
# Edición de Carreras
RewriteRule ^carreras/editar/([0-9]+)$ modules/carreras/carreras_abm.php?action=edit&id=$1 [L,QSA]

RewriteRule ^instituto/inscripcion$ modules/academico/inscripciones.php [L,QSA]
# =================================================================
# GESTIÓN DE PROFESORES - RUTAS BLINDADAS UUID
# =================================================================

# 1. Gestión principal y procesado de formularios
RewriteRule ^profesores/gestion$ modules/profesores/profesores_abm.php [L,QSA]

# 2. Edición de profesor (Mapea el hash al parámetro 'uuid')
