# 3. Procesamiento DataTables (ServerSide)
RewriteRule ^profesores/data_server$ ajax/profesores/serverside_processing_profesores.php [L,QSA]

# 4. Obtener alumnos por carrera (Modal)
RewriteRule ^profesores/get_alumnos$ ajax/profesores/get_alumnos_por_carrera.php [L,QSA]

# 5. Reportes y Documentos
RewriteRule ^profesores/legajo_pdf/([a-z0-9-]+)$ ajax/profesores/profesor_legajo_pdf.php?uuid=$1 [L,QSA]
RewriteRule ^profesores/historial/([a-z0-9-]+)$ modules/profesores/historial_recibos.php?uuid=$1 [L,QSA]
RewriteRule ^recibos/ver/([a-z0-9-]+)$ ajax/profesores/imprimir_recibo.php?uuid=$1 [L,QSA]
