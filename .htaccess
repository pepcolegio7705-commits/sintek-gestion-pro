RewriteRule ^profesores/imprimir-recibo/([a-z0-9-]+)$ ajax/profesores/imprimir_recibo.php?uuid=$1 [L,QSA]

# 6. Asignación de espacios curriculares
RewriteRule ^profesores/asignar/([a-z0-9-]+)$ modules/profesores/profesores_asignar.php?uuid=$1 [L,QSA]
RewriteRule ^profesores/guardarAsignacion/([a-z0-9-]+)$ ajax/profesores/guardar_asignacion.php?uuid=$1 [L,QSA]
# Regla para generar el PDF de certificación
RewriteRule ^profesores/certificacion/([a-z0-9-]+)$ ajax/profesores/certificacion_haberes_pdf.php?uuid=$1 [L,QSA]


#Datos Institución
RewriteRule ^academico/datos$ modules/academico/configuracion_abm.php [L,QSA]
# --- MÓDULO PERSONAL STAFF (REGLAS BLINDADAS) ---

