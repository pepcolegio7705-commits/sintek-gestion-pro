# Ruta para generar el PDF con FPDF
RewriteRule ^reporte/permanencia-pdf$ ajax/asistencias/generar_reporte_pdf.php [L,QSA]

# 1. VISTAS (Interfaces Gráficas)
# ---------------------------------------------------------

