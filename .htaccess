# Planilla de carga diaria (Recibe UUID del espacio y la Fecha)
# Ejemplo: /asistencias/planilla/550e8400-e29b-41d4/2026-03-26
RewriteRule ^asistencias-gestion/planilla/([a-z0-9-]+)/([0-9-]+)$ modules/asistencias/asistencia-planilla.php?uuid_espacio=$1&fecha=$2 [L,QSA]

# Reporte Mensual de Asistencias: /asistencias/reporte-mensual/UUID_CARRERA/UUID_ESPACIO/MES/ANIO

RewriteRule ^asistencias/reporte-mensual/([a-z0-9-]+)/([a-z0-9-]+)/([0-9]+)/([0-9]+)/?$ modules/asistencias/asistencia_sabana.php?uuid_carrera=$1&uuid_espacio=$2&mes=$3&anio=$4 [L,QSA]

